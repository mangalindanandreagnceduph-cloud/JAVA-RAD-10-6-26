import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        boolean continueCalculating = true;

        System.out.println("Interactive Switch-Case Calculator");

     while (continueCalculating) {
     System.out.print("\nEnter the value for x: ");
     double x = input.nextDouble();

     System.out.print("Enter the value for y: ");
      double y = input.nextDouble();
     System.out.print("Choose an operator (+, -, *, /): ");
     char operator = input.next().charAt(0);
      double result = 0;
      boolean validOperator = true;
         
      switch (operator) {
        case '+':
           result = x + y;
                break;
        case '-':
            result = x - y;
                break;
        case '*':
            result = x * y;
                break;
        case '/':
            if (y != 0) {
             result = x / y;
                } else {
System.out.println("Error: Division by zero is not allowed."); 
                validOperator = false;
                    }
                  break;
                default:
System.out.println("Invalid operator selected! Please use +, -, *, or /.");
                    validOperator = false;
                    break;
            }

           if (validOperator) {
System.out.printf("Result: %.2f %c %.2f = %.2f%n", x, operator, y, result);
            }
System.out.print("\nDo you want to perform another calculation? (y/n): ");
    
char choice = input.next().toLowerCase().charAt(0);
           
     if (choice != 'y') {
      continueCalculating = false;
System.out.println("Thank you for using the calculator program!");
            }
        }

        input.close();
    }
}





import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        
        System.out.println("Loop Conditions: Max 30, Skip 7, Break at 30 ");
        
        int i = 1;
        while (i <= 100) {
            if (i == 7) {
                System.out.println("[Skipping number 7]");
                i++; 
                continue;
            }
            if (i == 30) {
                System.out.println("\nReached 30! Stopping the program using a break statement.");
                break; 
            }
            System.out.println("\nCurrent number tracker: " + i);
            System.out.print("Enter a number to check if it's divisible by 30: ");
            int userNum = input.nextInt();
            if (userNum % 30 == 0) {
                System.out.println("-> Success! " + userNum + " is divisible by 30.");
            } else {
                System.out.println("-> No, " + userNum + " is NOT divisible by 30.");
            }
            i++;
        }
        System.out.println("Loop exited successfully.");
        input.close();
    }
}





